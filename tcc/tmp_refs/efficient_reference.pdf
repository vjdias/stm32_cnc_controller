});</script><script>document.addEventListener('DOMContentLoaded', () => { const loginButton = document.querySelector('.js-login-button--c2e9a488'); if (!loginButton) { throw new Error('Login button not found'); } const options = { detail: {"postLoginRedirectUrl":"https://www.academia.edu/144937501/Impact_of_Oral_Frailty_on_General_Frailty_in_Geriatric_Population_A_Scoping_Review","clickTrackingContext":{"source":"loswp--wsj-grid-card-download-pdf-modal","bucket":"outline","entity_id":144937501,"extra":{"source_work_id":144937501}},"configuredText":{"buttonsPage":{"header":"Read your PDF for free"},"emailEntryPage":{"subheader":"Sign up or log in to continue reading."},"emailLoginPage":{"subheader":"Log in to continue reading."},"emailRegistrationPage":{"subheader":"Sign up to continue reading."}},"registrationParams":{"user_source":"download","doc_id":125364239}} }; loginButton.addEventListener('click', () => { document.dispatchEvent(new CustomEvent('open-login-modal', options)); }); });</script><a class="ds2-5-text-link ds2-5-text-link--inline js-wsj-grid-card-view-pdf" href="https://www.academia.edu/144937501/Impact_of_Oral_Frailty_on_General_Frailty_in_Geriatric_Population_A_Scoping_Review"><span class="ds2-5-text-link__content">View PDF</span><span class="material-symbols-outlined" style="font-size: 18px" translate="no">chevron_right</span></a></div></div><div class="ds-related-work--container js-wsj-grid-card js-safe-related-work-wsj " data-collection-position="7" data-entity-id="144939954" data-sort-order="default"><a class="ds-related-work--title js-wsj-grid-card-title ds2-5-body-md ds2-5-body-link" href="https://www.academia.edu/144939954/A_rapid_and_simple_method_to_detect_ESBL_in_Enterobacter_cloacae_based_on_MIC_of_cefepime">A rapid and simple method to detect ESBL in Enterobacter cloacae based on MIC of cefepime</a><div class="ds-related-work--metadata"><a class="js-wsj-grid-card-author ds2-5-body-sm ds2-5-body-link" data-author-id="58195625" href="https://independent.academia.edu/RafaelMoreira73">Rafael R B Moreira</a></div><p class="ds-related-work--metadata ds2-5-body-xs">Revista da Sociedade Brasileira de Medicina Tropical, 2015</p><p class="ds2-5-body-sm ds-related-work--abstract ">The aim of this study was to identify a rapid and simple phenotypic method for extended-spectrum β-lactamase (ESBL) detection in Enterobacter cloacae. Methods: A total of 79 consecutive, non-repeated samples of E. cloacae were evaluated. Four phenotypic methods were applied for ESBL detection, results were compared to multiplex polymerase chain reaction (PCR) as the gold standard reference method: 1) ceftazidime and cefotaxime disks with and without clavulanate, both with boronic acid added; 2) disk approximation using cefepime and amoxicillin/clavulanate; 3) ESBL screening by minimum inhibitory concentration (MIC) ≥ 16µg/mL and 4) by MIC ≥ 2µg/mL for cefepime. Results: Method 4 showed the best combination of sensitivity (100%) and specifi city (94%). Conclusions: MIC ≥ 2µg/mL for cefepime would be very useful for the phenotypic detection of ESBL in samples of E. cloacae.</p><div class="ds-related-work--ctas"><a class="ds2-5-text-link ds2-5-text-link--inline js-tc-loswp--wsj-grid-card-download-pdf-modal js-login-button--6bd420d1"><span class="material-symbols-outlined" style="font-size: 18px" translate="no">download</span><span class="ds2-5-text-link__content">Download free PDF</span></a><script>document.addEventListener('DOMContentLoaded', () => {
