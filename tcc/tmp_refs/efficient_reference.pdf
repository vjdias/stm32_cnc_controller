ll-width js-tc-loswp--references-view-more references--view-more-link" onclick="this.parentElement.classList.add(&#39;references--show-all&#39;);">View more<span class="material-symbols-outlined" style="font-size: 20px" translate="no">arrow_downward</span></button><script>document.addEventListener('DOMContentLoaded', () => {
